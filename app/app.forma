forma plates

// The three chip tones, from the hosted workspace's design tokens
// (lib/web/design.mjs: --danger, --warn, --ok; light and dark paired).
// tests/app-fixture.test.mjs holds these equal to that file. A tone always
// travels with a symbol and, when it is not green, a line of words.
theme
  danger = light-dark(oklch(0.49 0.17 28), oklch(0.74 0.15 28))
  warn = light-dark(oklch(0.45 0.09 65), oklch(0.85 0.09 78))
  ok = light-dark(oklch(0.46 0.1 155), oklch(0.76 0.11 158))
