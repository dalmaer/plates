{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "excludeFiles": "{{tests,docs,.agents,.claude,.plates,.github}/{**,**/.*,**/.*/**,**/.*/**/.*},{lib,scripts}/discord-pilot/**,lib/web/capability-source-{inventory,data}.mjs,lib/validation-{plan,capabilities,conventions}.mjs}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
